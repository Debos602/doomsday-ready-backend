PORT=4000

# Web app origin allowed by CORS (comma-separate several). Leave empty to allow any origin.
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=doomsday_ready

# Prisma reads this one. It is built from the DB_* values above.
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"
